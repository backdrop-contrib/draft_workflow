<?php
/**
 * @file
 * Install, update, and uninstall functions for the Draft Workflow module.
 */

/**
 * Implements hook_schema().
 */
function draft_workflow_schema() {
  $schema['draft_workflow_review'] = _draft_workflow_review_table_schema();
  return $schema;
}

/**
 * Returns the schema for the {draft_workflow_review} table.
 *
 * Shared by hook_schema() and draft_workflow_update_1100(), so fresh installs
 * and updated sites get the same table.
 */
function _draft_workflow_review_table_schema() {
  return array(
    'description' => 'Draft revisions that have been marked ready for review.',
    'fields' => array(
      'vid' => array(
        'description' => 'The {node_revision}.vid of the draft.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'nid' => array(
        'description' => 'The {node}.nid the draft belongs to.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'uid' => array(
        'description' => 'The {users}.uid of the person who marked the draft ready for review.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'created' => array(
        'description' => 'The Unix timestamp when the draft was marked ready for review.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('vid'),
    'indexes' => array(
      'nid' => array('nid'),
    ),
  );
}

/**
 * Install the Pending Review view.
 */
function draft_workflow_update_1000() {
  config_install_default_config('draft_workflow', 'views.view.draft_workflow_pending_review');
}

/**
 * Add a table to record drafts that are ready for review.
 */
function draft_workflow_update_1100() {
  if (!db_table_exists('draft_workflow_review')) {
    db_create_table('draft_workflow_review', _draft_workflow_review_table_schema());
  }
}

/**
 * Make every revision's published status match its content's status.
 *
 * Revisions saved outside the draft workflow forms (bulk actions, scheduled
 * publishing, code) could keep an out-of-date status, which made "Make current
 * revision" and "Revert" publish or unpublish content unexpectedly.
 */
function draft_workflow_update_1101() {
  foreach (array_keys(node_type_get_types()) as $type) {
    // Before draft_workflow_update_1102(), content types without the setting
    // used the draft workflow, so check the setting itself here.
    $enabled = config_get('node.type.' . $type, 'settings.draft_workflow_enabled');
    if ($enabled !== NULL && !$enabled) {
      continue;
    }
    db_query('UPDATE {node_revision} SET status = (SELECT n.status FROM {node} n WHERE n.nid = {node_revision}.nid) WHERE nid IN (SELECT nid FROM {node} WHERE type = :type)', array(':type' => $type));
  }
}

/**
 * Keep the draft workflow enabled on existing content types.
 *
 * Content types without a saved "Enable draft workflow" setting used to have
 * the draft workflow enabled. It is now off unless it is turned on, so save
 * the setting on existing content types to keep them as they are.
 */
function draft_workflow_update_1102() {
  foreach (array_keys(node_type_get_types()) as $type) {
    $config = config('node.type.' . $type);
    if ($config->isNew() || $config->get('settings.draft_workflow_enabled') !== NULL) {
      continue;
    }
    $config->set('settings.draft_workflow_enabled', TRUE);
    $config->save();
  }
}

/**
 * Remove "ready for review" marks from drafts older than the current revision.
 *
 * These drafts were overtaken by a newer current revision. From now on their
 * marks are removed when that happens.
 */
function draft_workflow_update_1103() {
  db_query('DELETE FROM {draft_workflow_review} WHERE vid <= (SELECT n.vid FROM {node} n WHERE n.nid = {draft_workflow_review}.nid)');
}

/**
 * Add the "Ready for review" view.
 *
 * Lists content with a draft that is marked ready for review, at
 * admin/content/ready-for-review. Disable it in the Views UI if it is not
 * wanted. The existing Pending Review view is not changed.
 */
function draft_workflow_update_1104() {
  if (!config('views.view.draft_workflow_ready_for_review')->isNew()) {
    return;
  }
  config_install_default_config('draft_workflow', 'views.view.draft_workflow_ready_for_review');
  views_invalidate_cache();
}
